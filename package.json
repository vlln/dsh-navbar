{
  "name": "@dsh-external/dsh-navbar",
  "description": "对话节点导航条——user 消息快速跳转（自渲染 DOM，官方 client 通道）",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": { "default": "./lib/index.mjs" },
    "./client": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dshClient": {
    "inject": ["@deepseek-ai/dsh-client-runtime"],
    "platform": "web"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  }
}
